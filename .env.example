# Supabase Configuration
# Get these from your Supabase project settings: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
# Fallback for older Supabase projects only. Prefer NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# SlipOK Payment Slip Verification
# Get these from SlipOK: https://www.slipok.com/
SLIPOK_API_URL=https://api.slipok.com/api/line/apikey/YOUR_API_KEY_ID
SLIPOK_API_KEY=your-slipok-api-key-here

# Shared SlipOK Test Mode (Legacy + Progressive Payment)
# Owner-approved current production policy: true. Both payment flows auto-verify
# through their normal state machines without calling the SlipOK network.
SLIPOK_TEST_MODE=true
